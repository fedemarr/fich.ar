generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RolUsuario {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SUPERVISOR
}

enum EstadoColaborador {
  ACTIVO
  INACTIVO
  DESACTIVADO
}

enum TipoNovedad {
  P
  PT
  AU
  VAC
  EN
  FR
  FE
  HDO
  C
  DES
  VIR
  ST
}

enum TipoFichada {
  ENTRADA
  SALIDA
}

enum MetodoFichada {
  QR_WHATSAPP
  QR_WEB
  MANUAL
}

enum AnalisisFichada {
  LLEGADA_EN_TIEMPO
  LLEGADA_TARDE
  SALIDA_ANTICIPADA
  SALIDA_EN_TIEMPO
  SALIDA_TARDE
  SIN_SALIDA
  FUERA_DE_RANGO
}

enum EstadoNotificacion {
  NO_LEIDA
  LEIDA
}

enum TipoNotificacion {
  FALLA_FICHADA
  INASISTENCIA
  SISTEMA
  COMUNICACION_NUEVA
}

model Empresa {
  id         String    @id @default(uuid())
  nombre     String
  slug       String    @unique
  logo_url             String?
  activa               Boolean   @default(true)
  modulo_operaciones   Boolean   @default(false)
  operaciones_v2       Boolean   @default(false)
  fichaje_libre        Boolean   @default(false)
  stats_token          String    @unique @default(uuid())
  recordatorios_wa     Boolean   @default(true)
  descanso_wa          Boolean   @default(true)
  created_at           DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  usuarios       Usuario[]
  colaboradores  Colaborador[]
  puntos_fichaje PuntoFichaje[]
  jornadas       Jornada[]
  fichadas       Fichada[]
  novedades      Novedad[]
  comunicaciones Comunicacion[]
  notificaciones Notificacion[]
  proyecciones   ProyeccionMensual[]
  asignaciones   AsignacionMensual[]
  descansos      Descanso[]
  cobros         Cobro[]
  sedes              Sede[]
  turnos             Turno[]
  procedimientos     Procedimiento[]
  ejecuciones_proc   EjecucionProcedimiento[]
  ejecuciones_tarea  EjecucionTarea[]
  fotos_op           FotoOperacion[]
  fichas_sector      FichaSector[]
  sectores           Sector[]
  rutinas_diarias    RutinaDiaria[]
  rondas_muestreo    RondaMuestreo[]
  verificaciones_sector VerificacionSector[]
  reclamos           Reclamo[]
  supervisiones      Supervision[]

  @@map("empresas")
}

model Usuario {
  id                     String     @id @default(uuid())
  empresa_id             String
  nombre                 String
  email                  String     @unique
  password               String
  rol                    RolUsuario @default(ADMIN)
  activo                 Boolean    @default(true)
  puede_gestionar_puntos Boolean    @default(false)
  identificacion         String?
  created_at             DateTime   @default(now())
  updated_at             DateTime   @updatedAt
  deleted_at             DateTime?

  empresa           Empresa        @relation(fields: [empresa_id], references: [id])
  fichadas_manuales Fichada[]      @relation("FichadaManualUsuario")
  puntos_asignados  UsuarioPunto[]
  rondas_muestreo   RondaMuestreo[]
  verificaciones    VerificacionSector[] @relation("VerificacionSupervisor")
  supervisiones     Supervision[]

  @@index([empresa_id])
  @@map("usuarios")
}

model UsuarioPunto {
  id               String @id @default(uuid())
  usuario_id       String
  punto_fichaje_id String

  usuario       Usuario      @relation(fields: [usuario_id], references: [id])
  punto_fichaje PuntoFichaje @relation(fields: [punto_fichaje_id], references: [id])

  @@unique([usuario_id, punto_fichaje_id])
  @@index([usuario_id])
  @@index([punto_fichaje_id])
  @@map("usuario_puntos")
}

model Colaborador {
  id             String            @id @default(uuid())
  empresa_id     String
  nombre         String
  apellido       String
  celular        String
  identificacion String?
  legajo         String?
  email          String?
  avatar_url     String?
  sector         String?
  domicilio      String?
  estado                EstadoColaborador @default(ACTIVO)
  fecha_ingreso         DateTime?
  omitir_recordatorio   Boolean           @default(false)
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt
  deleted_at            DateTime?

  empresa        Empresa              @relation(fields: [empresa_id], references: [id])
  fichadas       Fichada[]
  novedades      Novedad[]
  notificaciones Notificacion[]
  jornadas       ColaboradorJornada[]
  asignaciones   AsignacionMensual[]
  descansos      Descanso[]
  ejecuciones_tarea EjecucionTarea[]
  fotos_op          FotoOperacion[]
  rutinas_diarias   RutinaDiaria[]
  reclamos_asignados Reclamo[]        @relation("ReclamoColaborador")

  @@index([empresa_id])
  @@index([celular])
  @@map("colaboradores")
}

model PuntoFichaje {
  id           String   @id @default(uuid())
  empresa_id   String
  sede_id      String?
  nombre       String
  latitud      Float
  longitud     Float
  radio_metros Int      @default(200)
  qr_token           String   @unique @default(uuid())
  operaciones_token  String   @unique @default(uuid())
  activo             Boolean  @default(true)
  descanso_activo    Boolean  @default(false)
  descanso_inicio    DateTime?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  empresa           Empresa        @relation(fields: [empresa_id], references: [id])
  sede              Sede?          @relation(fields: [sede_id], references: [id])
  fichadas          Fichada[]
  jornadas          Jornada[]
  asignaciones      AsignacionMensual[]
  supervisores      UsuarioPunto[]
  tareas_op         Tarea[]
  procedimientos    Procedimiento[]
  supervisiones     Supervision[]

  @@index([empresa_id])
  @@index([qr_token])
  @@index([operaciones_token])
  @@map("puntos_fichaje")
}

model Jornada {
  id               String  @id @default(uuid())
  empresa_id       String
  punto_fichaje_id String
  nombre           String
  hora_inicio      String
  hora_fin         String
  tolerancia_min   Int     @default(15)

  lunes_presencial     Boolean @default(false)
  martes_presencial    Boolean @default(false)
  miercoles_presencial Boolean @default(false)
  jueves_presencial    Boolean @default(false)
  viernes_presencial   Boolean @default(false)
  sabado_presencial    Boolean @default(false)
  domingo_presencial   Boolean @default(false)

  lunes_virtual     Boolean @default(false)
  martes_virtual    Boolean @default(false)
  miercoles_virtual Boolean @default(false)
  jueves_virtual    Boolean @default(false)
  viernes_virtual   Boolean @default(false)
  sabado_virtual    Boolean @default(false)
  domingo_virtual   Boolean @default(false)

  activo     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  empresa       Empresa              @relation(fields: [empresa_id], references: [id])
  punto_fichaje PuntoFichaje         @relation(fields: [punto_fichaje_id], references: [id])
  colaboradores ColaboradorJornada[]

  @@index([empresa_id])
  @@index([punto_fichaje_id])
  @@map("jornadas")
}

model ColaboradorJornada {
  id             String    @id @default(uuid())
  colaborador_id String
  jornada_id     String
  fecha_desde    DateTime  @default(now())
  fecha_hasta    DateTime?

  colaborador Colaborador @relation(fields: [colaborador_id], references: [id])
  jornada     Jornada     @relation(fields: [jornada_id], references: [id])

  @@index([colaborador_id])
  @@index([jornada_id])
  @@map("colaborador_jornadas")
}

model Fichada {
  id                String           @id @default(uuid())
  empresa_id        String
  colaborador_id    String
  punto_fichaje_id  String?
  tipo              TipoFichada
  metodo            MetodoFichada    @default(QR_WHATSAPP)
  timestamp         DateTime         @default(now())
  latitud_real      Float?
  longitud_real     Float?
  distancia_metros  Int?
  analisis          AnalisisFichada?
  es_valida         Boolean          @default(true)
  es_cobertura      Boolean          @default(false)
  nota_manual       String?
  usuario_manual_id String?

  usuario_manual Usuario?      @relation("FichadaManualUsuario", fields: [usuario_manual_id], references: [id])
  empresa        Empresa       @relation(fields: [empresa_id], references: [id])
  colaborador    Colaborador   @relation(fields: [colaborador_id], references: [id])
  punto_fichaje  PuntoFichaje? @relation(fields: [punto_fichaje_id], references: [id])

  created_at DateTime @default(now())

  @@index([empresa_id])
  @@index([colaborador_id])
  @@index([empresa_id, timestamp])
  @@index([colaborador_id, timestamp])
  @@map("fichadas")
}

model Novedad {
  id             String      @id @default(uuid())
  empresa_id     String
  colaborador_id String
  fecha          DateTime    @db.Date
  tipo           TipoNovedad
  observacion    String?
  aprobada       Boolean     @default(false)
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  empresa     Empresa     @relation(fields: [empresa_id], references: [id])
  colaborador Colaborador @relation(fields: [colaborador_id], references: [id])

  @@unique([colaborador_id, fecha])
  @@index([empresa_id])
  @@index([empresa_id, fecha])
  @@map("novedades")
}

model Comunicacion {
  id           String    @id @default(uuid())
  empresa_id   String
  texto        String
  fecha_inicio DateTime  @default(now())
  fecha_fin    DateTime
  activa       Boolean   @default(true)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  empresa Empresa @relation(fields: [empresa_id], references: [id])

  @@index([empresa_id])
  @@map("comunicaciones")
}

model Notificacion {
  id             String             @id @default(uuid())
  empresa_id     String
  colaborador_id String?
  tipo           TipoNotificacion
  titulo         String
  descripcion    String?
  estado         EstadoNotificacion @default(NO_LEIDA)
  metadata       Json?
  created_at     DateTime           @default(now())

  empresa     Empresa      @relation(fields: [empresa_id], references: [id])
  colaborador Colaborador? @relation(fields: [colaborador_id], references: [id])

  @@index([empresa_id])
  @@index([empresa_id, estado])
  @@map("notificaciones")
}

model WebhookWA {
  id            String   @id @default(uuid())
  from_number   String
  body          String
  latitud       Float?
  longitud      Float?
  wa_message_id String   @unique
  procesado     Boolean  @default(false)
  error         String?
  created_at    DateTime @default(now())

  @@index([from_number])
  @@map("webhooks_wa")
}

model ProyeccionMensual {
  id         String   @id @default(uuid())
  empresa_id String
  mes        Int
  anio       Int
  archivo    String?
  subido_por String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  empresa      Empresa             @relation(fields: [empresa_id], references: [id])
  asignaciones AsignacionMensual[]

  @@unique([empresa_id, mes, anio])
  @@index([empresa_id])
  @@map("proyecciones_mensuales")
}

model AsignacionMensual {
  id               String  @id @default(uuid())
  empresa_id       String
  proyeccion_id    String
  colaborador_id   String
  punto_fichaje_id String?
  servicio_nombre  String
  nro_socio        String?
  categoria        String?
  valor_hora       Float?
  hora_inicio      String?
  hora_fin         String?

  dia_01 Float?
  dia_02 Float?
  dia_03 Float?
  dia_04 Float?
  dia_05 Float?
  dia_06 Float?
  dia_07 Float?
  dia_08 Float?
  dia_09 Float?
  dia_10 Float?
  dia_11 Float?
  dia_12 Float?
  dia_13 Float?
  dia_14 Float?
  dia_15 Float?
  dia_16 Float?
  dia_17 Float?
  dia_18 Float?
  dia_19 Float?
  dia_20 Float?
  dia_21 Float?
  dia_22 Float?
  dia_23 Float?
  dia_24 Float?
  dia_25 Float?
  dia_26 Float?
  dia_27 Float?
  dia_28 Float?
  dia_29 Float?
  dia_30 Float?
  dia_31 Float?

  total_horas Float?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  empresa       Empresa            @relation(fields: [empresa_id], references: [id])
  proyeccion    ProyeccionMensual  @relation(fields: [proyeccion_id], references: [id])
  colaborador   Colaborador        @relation(fields: [colaborador_id], references: [id])
  punto_fichaje PuntoFichaje?      @relation(fields: [punto_fichaje_id], references: [id])

  @@index([empresa_id])
  @@index([proyeccion_id])
  @@index([colaborador_id])
  @@map("asignaciones_mensuales")
}

model Descanso {
  id             String    @id @default(uuid())
  empresa_id     String
  colaborador_id String
  inicio         DateTime  @default(now())
  fin            DateTime?
  created_at     DateTime  @default(now())

  empresa     Empresa     @relation(fields: [empresa_id], references: [id])
  colaborador Colaborador @relation(fields: [colaborador_id], references: [id])

  @@index([empresa_id])
  @@index([colaborador_id])
  @@index([empresa_id, inicio])
  @@map("descansos")
}

model AuditLog {
  id         String   @id @default(uuid())
  empresa_id String?
  usuario_id String?
  rol        String
  accion     String
  entidad    String?
  entidad_id String?
  detalle    Json?
  ip         String?
  user_agent String?
  created_at DateTime @default(now())

  @@index([empresa_id])
  @@index([created_at])
  @@index([accion])
  @@map("audit_logs")
}

model Cobro {
  id                String    @id @default(uuid())
  empresa_id        String
  concepto          String
  monto             Float
  moneda            String    @default("ARS")
  periodo           String?
  estado            String    @default("PENDIENTE")
  fecha_emision     DateTime  @default(now())
  fecha_vencimiento DateTime?
  fecha_pago        DateTime?
  nota              String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  empresa Empresa @relation(fields: [empresa_id], references: [id])

  @@index([empresa_id])
  @@index([estado])
  @@map("cobros")
}

// ─── MÓDULO OPERACIONES ───────────────────────────────────────────────────────

model Sede {
  id         String   @id @default(uuid())
  empresa_id String
  nombre     String
  activo     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  empresa         Empresa         @relation(fields: [empresa_id], references: [id])
  puntos          PuntoFichaje[]
  sectores        Sector[]
  rondas_muestreo RondaMuestreo[]

  @@index([empresa_id])
  @@map("sedes")
}

model Turno {
  id          String   @id @default(uuid())
  empresa_id  String
  nombre      String
  hora_inicio String
  hora_fin    String
  activo      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  empresa         Empresa                  @relation(fields: [empresa_id], references: [id])
  procedimientos  Procedimiento[]
  ejecuciones     EjecucionProcedimiento[]
  rutinas_diarias RutinaDiaria[]

  @@index([empresa_id])
  @@map("turnos")
}

model Procedimiento {
  id               String   @id @default(uuid())
  empresa_id       String
  turno_id         String
  punto_fichaje_id String?
  nombre           String
  descripcion      String?
  lunes       Boolean  @default(false)
  martes      Boolean  @default(false)
  miercoles   Boolean  @default(false)
  jueves      Boolean  @default(false)
  viernes     Boolean  @default(false)
  sabado      Boolean  @default(false)
  domingo     Boolean  @default(false)
  activo      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  empresa       Empresa                  @relation(fields: [empresa_id], references: [id])
  turno         Turno                    @relation(fields: [turno_id], references: [id])
  punto_fichaje PuntoFichaje?            @relation(fields: [punto_fichaje_id], references: [id])
  tareas        Tarea[]
  ejecuciones   EjecucionProcedimiento[]

  @@index([empresa_id])
  @@index([turno_id])
  @@index([punto_fichaje_id])
  @@map("procedimientos")
}

model Tarea {
  id                  String   @id @default(uuid())
  procedimiento_id    String
  punto_fichaje_id    String?
  nombre              String
  descripcion         String?
  seccion             String?
  orden               Int
  es_critica          Boolean  @default(false)
  es_omitible         Boolean  @default(true)
  tiempo_estimado_min Int?
  foto_min            Int      @default(0)
  foto_max            Int      @default(0)
  foto_instruccion      String?
  criterio_verificacion String?
  requiere_comentario   Boolean  @default(false)
  checklist_items       Json?
  activo                Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  procedimiento Procedimiento    @relation(fields: [procedimiento_id], references: [id])
  punto_fichaje PuntoFichaje?    @relation(fields: [punto_fichaje_id], references: [id])
  ejecuciones   EjecucionTarea[]

  @@index([procedimiento_id])
  @@map("tareas")
}

model EjecucionProcedimiento {
  id               String   @id @default(uuid())
  empresa_id       String
  procedimiento_id String
  turno_id         String
  fecha            DateTime @db.Date
  estado           String   @default("PENDIENTE")
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  empresa       Empresa        @relation(fields: [empresa_id], references: [id])
  procedimiento Procedimiento  @relation(fields: [procedimiento_id], references: [id])
  turno         Turno          @relation(fields: [turno_id], references: [id])
  tareas        EjecucionTarea[]

  @@unique([procedimiento_id, fecha])
  @@index([empresa_id])
  @@index([empresa_id, fecha])
  @@map("ejecuciones_procedimiento")
}

model EjecucionTarea {
  id                         String    @id @default(uuid())
  empresa_id                 String
  ejecucion_procedimiento_id String
  tarea_id                   String
  colaborador_id             String?
  estado                     String    @default("PENDIENTE")
  hora_inicio                DateTime?
  hora_fin                   DateTime?
  latitud_completado         Float?
  longitud_completado        Float?
  comentario                 String?
  checklist_completado       Json?
  se_salteo_orden            Boolean   @default(false)
  motivo_salteo              String?
  validacion_estado          String    @default("PENDIENTE")
  validado_por_id            String?
  motivo_rechazo             String?
  created_at                 DateTime  @default(now())
  updated_at                 DateTime  @updatedAt

  empresa               Empresa                @relation(fields: [empresa_id], references: [id])
  ejecucion_procedimiento EjecucionProcedimiento @relation(fields: [ejecucion_procedimiento_id], references: [id])
  tarea                 Tarea                  @relation(fields: [tarea_id], references: [id])
  colaborador           Colaborador?           @relation(fields: [colaborador_id], references: [id])
  fotos                 FotoOperacion[]

  @@index([empresa_id])
  @@index([ejecucion_procedimiento_id])
  @@index([tarea_id])
  @@map("ejecuciones_tarea")
}

model FotoOperacion {
  id                 String    @id @default(uuid())
  empresa_id         String
  ejecucion_tarea_id String
  colaborador_id     String
  key                String?
  thumbnail_key      String?
  bytes              Int?
  ancho              Int?
  alto               Int?
  timestamp_captura  DateTime?
  latitud_captura    Float?
  longitud_captura   Float?
  estado_subida      String    @default("PENDIENTE")
  hash               String?
  imagen_url         String?
  verificacion_ia    Json?
  created_at         DateTime  @default(now())

  empresa         Empresa        @relation(fields: [empresa_id], references: [id])
  ejecucion_tarea EjecucionTarea @relation(fields: [ejecucion_tarea_id], references: [id])
  colaborador     Colaborador    @relation(fields: [colaborador_id], references: [id])

  @@index([empresa_id])
  @@index([ejecucion_tarea_id])
  @@map("fotos_operaciones")
}

// ─── MÓDULO OPERACIONES v2 — Control por muestreo ────────────────────────────

model FichaSector {
  id                     String   @id @default(uuid())
  empresa_id             String
  tipo                   String
  puntos_revision        Json
  instruccion_foto       String?
  foto_ok_url            String?
  foto_mal_url           String?
  fallas_graves          Json?
  fallas_leves           Json?
  controles_presenciales Json
  umbral_aprobacion      Int      @default(80)
  activo                 Boolean  @default(true)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  empresa  Empresa   @relation(fields: [empresa_id], references: [id])
  sectores Sector[]

  @@index([empresa_id])
  @@map("fichas_sector")
}

model Sector {
  id              String   @id @default(uuid())
  empresa_id      String
  sede_id         String
  ficha_id        String?
  nombre          String
  qr_sector_token String   @unique @default(uuid())
  activo          Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  empresa        Empresa              @relation(fields: [empresa_id], references: [id])
  sede           Sede                 @relation(fields: [sede_id], references: [id])
  ficha          FichaSector?         @relation(fields: [ficha_id], references: [id])
  rutinas        RutinaDiaria[]
  verificaciones VerificacionSector[]
  reclamos       Reclamo[]

  @@index([empresa_id])
  @@index([sede_id])
  @@index([qr_sector_token])
  @@map("sectores")
}

model RutinaDiaria {
  id             String   @id @default(uuid())
  empresa_id     String
  sector_id      String
  colaborador_id String
  turno_id       String?
  fecha          DateTime @db.Date
  hora_escaneo   DateTime
  estado         String   @default("PENDIENTE")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  empresa     Empresa     @relation(fields: [empresa_id], references: [id])
  sector      Sector      @relation(fields: [sector_id], references: [id])
  colaborador Colaborador @relation(fields: [colaborador_id], references: [id])
  turno       Turno?      @relation(fields: [turno_id], references: [id])

  @@unique([sector_id, colaborador_id, fecha])
  @@index([empresa_id])
  @@index([empresa_id, fecha])
  @@map("rutinas_diarias")
}

model RondaMuestreo {
  id               String   @id @default(uuid())
  empresa_id       String
  sede_id          String
  supervisor_id    String
  fecha            DateTime @db.Date
  semilla          String
  cantidad_sectores Int
  estado           String   @default("EN_CURSO")
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  empresa        Empresa              @relation(fields: [empresa_id], references: [id])
  sede           Sede                 @relation(fields: [sede_id], references: [id])
  supervisor     Usuario              @relation(fields: [supervisor_id], references: [id])
  verificaciones VerificacionSector[]

  @@index([empresa_id])
  @@index([empresa_id, fecha])
  @@map("rondas_muestreo")
}

model VerificacionSector {
  id                     String   @id @default(uuid())
  empresa_id             String
  ronda_id               String
  sector_id              String
  supervisor_id          String
  foto_url               String?
  foto_hash              String?
  foto_timestamp         DateTime?
  foto_latitud           Float?
  foto_longitud          Float?
  puntaje_ia             Int?
  observacion_ia         String?
  falla_grave_ia         Boolean  @default(false)
  controles_presenciales Json?
  resultado_final        String?
  contradijo_ia          Boolean  @default(false)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  empresa    Empresa        @relation(fields: [empresa_id], references: [id])
  ronda      RondaMuestreo  @relation(fields: [ronda_id], references: [id])
  sector     Sector         @relation(fields: [sector_id], references: [id])
  supervisor Usuario        @relation("VerificacionSupervisor", fields: [supervisor_id], references: [id])

  @@index([empresa_id])
  @@index([ronda_id])
  @@index([sector_id])
  @@map("verificaciones_sector")
}

model Reclamo {
  id                    String    @id @default(uuid())
  empresa_id            String
  sector_id             String
  tipo                  String
  descripcion           String?
  hora_aviso            DateTime  @default(now())
  colaborador_id        String?
  foto_antes_url        String?
  foto_antes_hash       String?
  foto_despues_url      String?
  foto_despues_hash     String?
  puntaje_ia_despues    Int?
  hora_cierre           DateTime?
  tiempo_resolucion_min Int?
  estado                String    @default("ABIERTO")
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  empresa     Empresa      @relation(fields: [empresa_id], references: [id])
  sector      Sector       @relation(fields: [sector_id], references: [id])
  colaborador Colaborador? @relation("ReclamoColaborador", fields: [colaborador_id], references: [id])

  @@index([empresa_id])
  @@index([sector_id])
  @@index([empresa_id, estado])
  @@map("reclamos")
}

// ─── SUPERVISIONES ────────────────────────────────────────────────────────────

model Supervision {
  id               String   @id @default(uuid())
  empresa_id       String
  punto_fichaje_id String
  usuario_id       String
  timestamp        DateTime @default(now())
  estado           String   // "ok" | "novedad"
  checklist_json   Json
  observaciones    String?

  empresa       Empresa      @relation(fields: [empresa_id], references: [id])
  punto_fichaje PuntoFichaje @relation(fields: [punto_fichaje_id], references: [id])
  supervisor    Usuario      @relation(fields: [usuario_id], references: [id])

  @@index([empresa_id])
  @@index([punto_fichaje_id])
  @@index([empresa_id, timestamp])
  @@map("supervisiones")
}
